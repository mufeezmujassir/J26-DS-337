
APP_NAME=WANDARAYA Knowledge Base
ENVIRONMENT=development
DEBUG=true

# Google
GOOGLE_PLACES_API_KEY=

# Weather
OPENWEATHER_API_KEY=

# PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:root@postgres:5432/wandaraya

# Redis
REDIS_URL=redis://localhost:6379

# Qdrant
QDRANT_URL=http://localhost:6333

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# LangChain
LANGCHAIN_TRACING_V2=false

# Gemini (Future Components)
GEMINI_API_KEY=

EMBEDDING_MODEL=BAAI/bge-large-en-v1.5